# Discord Bot Configuration
# Copy this file to .env and fill in the details

# REQUIRED: Your Discord Bot Token (Get from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# OPTIONAL: Bot Configuration
BOT_PREFIX=/          # Default command prefix
BOT_ACTIVITY=Helping servers!  # Bot's playing status

# Logging Configuration
LOG_LEVEL=INFO            # Logging verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_FILE=logs/bot.log     # Path to log file

# Feature Toggles
LEVELING_ENABLED=true     # Enable/disable XP system
WELCOME_SYSTEM_ENABLED=true

# Moderation Settings
DEFAULT_MUTE_ROLE=        # ID of default mute role
MODERATION_LOGS_CHANNEL=  # ID of channel for moderation logs

# Ticket System Settings
TICKET_CATEGORY=Tickets
TICKET_SUPPORT_ROLE=Support Team

# Security Settings
ENCRYPTION_KEY=auto_generate  # Use 'auto_generate' or provide a custom key
ALLOWED_GUILDS=           # Comma-separated list of allowed guild IDs (optional)

# ADVANCED: Only change if you know what you're doing
INTENTS_OVERRIDE=false    # Set to true to manually configure Discord intents
